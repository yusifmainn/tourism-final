[Unit]
Description=Aze-Tourism
# network-online: the server calls the Kapital Bank API and DNS (visit log providers).
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
User=aze
# The program reads .env from this directory.
WorkingDirectory=/opt/aze-tourism
ExecStart=/opt/aze-tourism/aze-tourism
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

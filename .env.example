# Bu fayli .env adi ile kopyalayib doldurun. Etrafli: DEPLOY.md

# ===== Esas tenzimlemeler (DEPLOY.md, 2.5) =====
# Saytin domeni. Domen yoxdursa, yalniz yoxlama ucun :80 yazin (HTTPS olmur).
DOMAIN=aze-tourism.az
# PostgreSQL parolu, yalniz herf ve reqem olsun. Yaratmaq ucun: openssl rand -hex 16
POSTGRES_PASSWORD=

# ===== Docker bu uc deyeri nezere almir (docker-compose.yml ozu qurur), deyismeyin =====
# PAROL hissesini PostgreSQL istifadecisinin parolu ile evez edin.
DATABASE_URL=postgres://aze_user:PAROL@localhost:5432/aze_tourism?sslmode=disable
PORT=8080
# Caddy ve ya nginx arxasinda true yazin.
TRUST_PROXY=false

# ===== Admin panel parollari =====
# ADMIN_PASSWORD bosdursa, admin girisi admin / admin olur.
ADMIN_PASSWORD=
FINANCE_PASSWORD=
OPERATOR_PASSWORD=

# ===== Onlayn depozit odenisi (Kapital Bank) =====
# Saytin tam unvani, sonunda / olmadan. Bank musterini odenisden sonra
# PUBLIC_URL/odenis/netice unvanina qaytarir. Bos olsa ve DOMAIN domen adidirsa,
# https://DOMAIN istifade olunur.
PUBLIC_URL=
# Bankin verdiyi terminal login ve parolu. Ucu de (login, parol, unvan) dolu olanda
# onlayn odenis aktivdir; bos olanda rezervasiya qebul olunur, depoziti emekdaslar
# admin panelde "odenilmis" kimi qeyd edir.
KAPITAL_USERNAME=
KAPITAL_PASSWORD=
# Bankin API unvani. Bos qalsa: https://e-commerce.kapitalbank.az/api
# Bankin sinaq (sandbox) unvani: https://txpgtst.kapitalbank.az/api
KAPITAL_API_URL=
